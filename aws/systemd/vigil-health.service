[Unit]
Description=Vigil health and security check
Documentation=https://github.com/Paulbla30-stack/paul
After=vigil.service
# The agent publishes the status file this check reads; without it the
# check still runs and reports the absence as an alert.
Wants=vigil.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/vigil-health
# A breach exits 1, which marks the unit failed and shows up in
# `systemctl list-units --failed`.  The report itself goes to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigil-health
# Read-only check: it needs no write access anywhere.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
