[Unit]
Description=OpenClaw agentic agent (headless, agent-first)
Documentation=https://github.com/Paulbla30-stack/paul
After=network-online.target openclaw-bootstrap.service
Wants=network-online.target
Wants=openclaw-bootstrap.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Environment=PYTHONPATH=/usr/lib/openclaw
Environment=PYTHONUNBUFFERED=1
Environment=OPENCLAW_HEADLESS=1
RuntimeDirectory=openclaw
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/openclaw --headless --extra-config /etc/openclaw/cloud.yaml
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
# Agent-first: its log is the console.  Visible on the EC2 serial console
# and in `journalctl -u openclaw`.
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=openclaw
# Leave the agent full system access (that is the point of the box), but
# keep the obvious foot-guns off.
NoNewPrivileges=no
LimitNOFILE=65536
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
