#!/bin/sh
# OpenClaw Agent Launcher
# =======================
# Wrapper script that launches the OpenClaw Python agent
# with proper environment setup.

set -e

OPENCLAW_DIR="/usr/lib/openclaw"
CONFIG="/etc/openclaw/config.yaml"
LOG="/var/log/openclaw.log"

export PYTHONPATH="$OPENCLAW_DIR"

# Detect environment
if [ -n "$OPENCLAW_DEBUG" ] && [ "$OPENCLAW_DEBUG" = "1" ]; then
    DEBUG_FLAG="--debug"
else
    DEBUG_FLAG=""
fi

if [ -n "$OPENCLAW_SCANONLY" ] && [ "$OPENCLAW_SCANONLY" = "1" ]; then
    SCAN_FLAG="--scan-only"
else
    SCAN_FLAG=""
fi

# Check for Python (OPENCLAW_PYTHON wins; the AMI sets it in /etc/default/openclaw)
if [ -z "$OPENCLAW_PYTHON" ] && [ -r /etc/default/openclaw ]; then
    . /etc/default/openclaw
fi
if [ -n "$OPENCLAW_PYTHON" ] && [ -x "$OPENCLAW_PYTHON" ]; then
    PYTHON="$OPENCLAW_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "[!] ERROR: Python not found. Cannot start OpenClaw agent."
    exit 1
fi

echo "[*] Starting OpenClaw Agent..."
echo "[*] Python: $($PYTHON --version 2>&1)"
echo "[*] Config: $CONFIG"
echo ""

# Under systemd stdout already goes to the journal (and the serial console
# on the AMI), so skip the tee; on the ISO keep a file copy of the output.
if [ -n "$JOURNAL_STREAM" ] || [ "$OPENCLAW_NO_TEE" = "1" ]; then
    exec $PYTHON -m openclaw.main --config "$CONFIG" $DEBUG_FLAG $SCAN_FLAG "$@"
fi

exec $PYTHON -m openclaw.main --config "$CONFIG" $DEBUG_FLAG $SCAN_FLAG "$@" 2>&1 | tee -a "$LOG"
